# Liate.js Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit the actual .env file — it is in .gitignore.

# ─── Sarvam AI (India Sovereign LLM) ─────────────────────────────────────────
# Get your key at: https://sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key-here

# ─── Anthropic (Claude) ────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Google Gemini ─────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Groq ──────────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ─── Optional: MCP Tool Keys ───────────────────────────────────────────────────
# BRAVE_API_KEY=your-brave-search-key
# GITHUB_TOKEN=your-github-personal-access-token
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_TEAM_ID=T0XXXXXXX
# GOOGLE_MAPS_API_KEY=your-maps-key

# ─── Optional: OmniRoute (Free Local Gateway) ─────────────────────────────────
# OMNIROUTE_URL=http://localhost:20128/v1/chat/completions

# ─── Optional: AWS Configuration ──────────────────────────────────────────────
# AWS_REGION=ap-south-1  # Default: ap-south-1 (Mumbai, India sovereign)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ─── Optional: Enterprise Proxy URL Overrides ──────────────────────────────────
# Override provider base URLs to route through internal proxies or Azure OpenAI
# OPENAI_API_URL=https://your-azure-openai.openai.azure.com/v1
# ANTHROPIC_API_URL=https://your-proxy.internal/anthropic/v1/messages
# GROQ_API_URL=https://your-proxy.internal/groq/v1
# SARVAM_API_URL=https://api.sarvam.ai/v1
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# TOGETHER_API_URL=https://api.together.xyz/v1
# OPENROUTER_API_URL=https://openrouter.ai/api/v1

# ─── Optional: Liate Cloud Deployment ─────────────────────────────────────────
# LIATE_CLOUD_TOKEN=your-liate-cloud-deployment-token
# LIATE_ENDPOINT=http://localhost:7071
